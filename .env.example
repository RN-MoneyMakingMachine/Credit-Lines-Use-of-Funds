# Required. The code the family types on the login page.
ACCESS_CODE=change-me
# Required. A long random string used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional. When set, the record is stored in PostgreSQL.
# On Railway use ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Optional. Set to true if the database requires SSL (external connections).
PGSSL=false

# Optional. Used only when DATABASE_URL is empty. Default ./data/record.json
DATA_FILE=./data/record.json

# Optional. Railway sets PORT for you. Default 3000.
PORT=3000
